# Server (every setting is explained in docs/self-hosting.md)
PORT=8787
# Listen on one address only, e.g. 127.0.0.1 behind a reverse proxy on this machine (default: all interfaces).
HOST=
# Also the base of "Share with agent" links ($PUBLIC_URL/a/<id>), which is how agents connect.
PUBLIC_URL=https://grimoire.example.com
DATA_DIR=./data
# Reverse proxies whose X-Forwarded-* headers are believed (IPs/CIDRs, or none). Default: 127.0.0.0/8,::1
TRUSTED_PROXIES=

# Where workspaces are stored: local or codestorage (set it explicitly):
#   local        each workspace is a bare Git repo on this server's disk, $DATA_DIR/git/<workspace-id>.git (no accounts
#                needed; back up $DATA_DIR). GitHub workspaces are read-only copies.
#   codestorage  hosted Git on Code Storage (needs CODE_STORAGE_ORG and its key below); editable GitHub workspaces with the GitHub App.
# Unset: codestorage when CODE_STORAGE_ORG and the private key are both set, otherwise local.
STORAGE=

# Code Storage (STORAGE=codestorage only)
CODE_STORAGE_ORG=
CODE_STORAGE_PRIVATE_KEY_FILE=/etc/grimoire/code-storage.pem

# Sign-in (docs/self-hosting.md#sign-in): off (the default) or on.
#   off  no accounts and no sign-in anywhere: EVERYTHING IS SHARED. Every workspace is listed for everyone, and
#        everyone who can reach the server can do everything (create, rename, delete, remove workspaces; /mcp needs
#        no auth). Keep the server on a private network (HOST=127.0.0.1, Tailscale) or behind your own auth.
#   on   people sign in with Google (or GitHub below) to create; visitors who don't are guests who read and edit.
#        Needs GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (or GitHub sign-in): without them the server won't start.
# Either way anyone with a workspace's link can open and edit it.
SIGN_IN=off

# Sign in with Google, with SIGN_IN=on (OAuth client of type "Web application"; redirect URI
# $PUBLIC_URL/auth/google/callback). The secret can also come from GOOGLE_CLIENT_SECRET_FILE.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shown to apps (GET /api/server; default: PUBLIC_URL's host).
SERVER_NAME=

# Sign in with GitHub, with SIGN_IN=on (a GitHub App's client id/secret; the same app is used for repo sync).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=

# ALLOW_DEV_LOGIN=1 is a test hook (with SIGN_IN=on) (POST /auth/dev, no UI), honoured only when PUBLIC_URL is plain http.
ALLOW_DEV_LOGIN=0

# Behavior
DEFAULT_BRANCH=main
QUIET_MS=3000
# The demo workspace goes back to its tour this often, in minutes (0: only on restart). Default 15.
# DEMO_RESET_HOURS (the older setting) is still read when DEMO_RESET_MINUTES isn't set.
DEMO_RESET_MINUTES=15
POLL_MS=20000
# How often read-only GitHub repos are refreshed from GitHub (ms)
UPSTREAM_REFRESH_MS=300000
# Read-only GitHub repos people can add: in total, and per person
MAX_GITHUB_REPOS=100
MAX_GITHUB_REPOS_PER_USER=10
