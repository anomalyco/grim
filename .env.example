# Server
PORT=8787
# Also the base of "Share with agent" links ($PUBLIC_URL/a/<id>), which is how agents connect.
PUBLIC_URL=https://grimoire.example.com
DATA_DIR=./data

# Storage: Code Storage when both are set, otherwise local bare git repos in $DATA_DIR/git (dev only).
CODE_STORAGE_ORG=
CODE_STORAGE_PRIVATE_KEY_FILE=/etc/grimoire/code-storage.pem
# Secret configured on the Code Storage webhook pointing at $PUBLIC_URL/webhooks/codestorage
CODE_STORAGE_WEBHOOK_SECRET=

# Who may sign in: open (anyone; name-only/guest sign-in too if ALLOW_DEV_LOGIN=1) or emails (only Google-verified
# emails in ALLOWED_EMAILS: addresses or *@domain, comma-separated; no name-only sign-in).
SIGNIN=open
ALLOWED_EMAILS=

# Sign in with Google (OAuth client of type "Web application"; redirect URI $PUBLIC_URL/auth/google/callback).
# Leave empty to hide Google sign-in. The secret can also come from GOOGLE_CLIENT_SECRET_FILE.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shown to apps and in the /connect page (default: PUBLIC_URL's host).
SERVER_NAME=

# Sign in with GitHub (a GitHub App's client id/secret; the same app is used for repo sync).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Comma-separated GitHub logins allowed to sign in, or * for anyone. Empty: only the first user (admin).
ALLOWED_GITHUB_USERS=

# Enables the name-only login form and guest sign-in for people opening shared links (only with SIGNIN=open).
# Anyone can then sign in under a name of their choosing: only for local development or deliberately open servers.
ALLOW_DEV_LOGIN=0

# Behavior
NOTES_REPO=notes
DEFAULT_BRANCH=main
QUIET_MS=3000
POLL_MS=20000
# How often read-only GitHub repos are refreshed from GitHub (ms)
UPSTREAM_REFRESH_MS=300000
# Read-only GitHub repos people can add: in total, and per person
MAX_GITHUB_REPOS=100
MAX_GITHUB_REPOS_PER_USER=10
