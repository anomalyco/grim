# Server
PORT=8787
# Also the base of "Share with agent" links ($PUBLIC_URL/a/<id>), which is how agents connect.
PUBLIC_URL=https://grimoire.example.com
DATA_DIR=./data

# Where folders are stored: local or codestorage (set it explicitly):
#   local        each folder is a bare Git repo on this server's disk, $DATA_DIR/git/<folder-id>.git (no accounts
#                needed; back up $DATA_DIR). GitHub folders are read-only copies.
#   codestorage  hosted Git on Code Storage (needs CODE_STORAGE_ORG and its key below); editable GitHub folders with the GitHub App.
# Unset: codestorage when CODE_STORAGE_ORG and the private key are both set, otherwise local.
STORAGE=

# Code Storage (STORAGE=codestorage only)
CODE_STORAGE_ORG=
CODE_STORAGE_PRIVATE_KEY_FILE=/etc/grimoire/code-storage.pem
# Secret configured on the Code Storage webhook pointing at $PUBLIC_URL/webhooks/codestorage
CODE_STORAGE_WEBHOOK_SECRET=

# Anyone may sign in, and every folder is public: anyone signed in can open and edit it. For privacy, run your own
# server.

# Sign in with Google (OAuth client of type "Web application"; redirect URI $PUBLIC_URL/auth/google/callback).
# Leave empty to hide Google sign-in. The secret can also come from GOOGLE_CLIENT_SECRET_FILE.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shown to apps and in the /connect page (default: PUBLIC_URL's host).
SERVER_NAME=

# Sign in with GitHub (a GitHub App's client id/secret; the same app is used for repo sync).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=

# Enables the name-only login form and guest sign-in for people opening any /app link signed out. Anyone can then
# sign in under a name of their choosing (always as a new account).
ALLOW_DEV_LOGIN=0

# Behavior
NOTES_REPO=notes
DEFAULT_BRANCH=main
QUIET_MS=3000
POLL_MS=20000
# How often read-only GitHub repos are refreshed from GitHub (ms)
UPSTREAM_REFRESH_MS=300000
# Read-only GitHub repos people can add: in total, and per person
MAX_GITHUB_REPOS=100
MAX_GITHUB_REPOS_PER_USER=10
