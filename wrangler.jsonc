{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grim",
  "main": "src/workers/index.ts",
  // Must be ≤ the pinned workerd's newest supported date (workerd 1.20260811.1 → 2026-08-18)
  // and ≥ 2026-04-21 (enhanced_error_serialization keeps error names across RPC).
  "compatibility_date": "2026-08-18",
  // enable_request_signal: an agent's command stops when its caller goes away.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Bun-only modules the shared code imports, swapped for their Workers versions or stand-ins (src/workers/stubs.ts).
  // Keys are import specifiers as written; values are resolved from the project root.
  "alias": {
    "./trust.ts": "./src/server/notes/trust.workers.ts",
    // until config.ts stops importing node:fs
    "node:fs": "./src/workers/stubs.ts"
  },
  // The static site is staged so URLs match the Bun server: dist/ under /dist/, and the app's HTML, CSS and the
  // Cloudflare _headers/_redirects (written by `bun run build:client`) at the root, with the icons and web manifest
  // (src/client/icons/), and the link-preview images under /og/ (src/client/og/). Run the client build first.
  "build": {
    "command": "rm -rf .wrangler/assets && mkdir -p .wrangler/assets && cp -al dist .wrangler/assets/dist && cd .wrangler/assets && for f in index.html app.css editor.css _headers _redirects; do if [ -e dist/$f ]; then mv dist/$f .; fi; done && rm -f dist/*.gz && cp ../../src/client/icons/* . && mkdir og && cp ../../src/client/og/*.png og/"
  },
  "assets": {
    "directory": "./.wrangler/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /app/*: note URLs answer Markdown to curl and agents (src/server/note-url.ts), and agents POST commands to a
    // workspace URL (src/server/agent-url.ts); browsers get index.html from ASSETS. /a/*: old agent links (410).
    // "/", "/app", "/scratch": the HTML gets its link-preview tags for the path and PUBLIC_URL (src/server/share-meta.ts)
    "run_worker_first": ["/", "/app", "/scratch", "/app/*", "/api/*", "/ws*", "/auth/*", "/a/*", "/mcp", "/oauth/*", "/.well-known/oauth-*", "/download/*", "/admin/*"]
  },
  // Production (`wrangler deploy`, CF-36): Worker grim at https://grimnotes.app. Secrets (wrangler secret put …):
  // GOOGLE_CLIENT_SECRET. Notes live in each WorkspaceDO's SQLite (docs/storage-v2.md); images and nightly exports in R2. Local `wrangler dev` overrides the
  // production-only vars (bun run dev:workers, scripts/wrangler-dev.ts; docs/06-cloudflare.md).
  // Workers Custom Domain; with routes set, wrangler turns the workers.dev URL off (one public origin)
  "routes": [{ "pattern": "grimnotes.app", "custom_domain": true }],
  "vars": {
    // Cloudflare's CF-Connecting-IP is the caller's address; no X-Forwarded-For is believed (src/server/proxy.ts).
    "TRUSTED_PROXIES": "none",
    // our hosted site: the landing page at "/" with its pencils (HomeDO). Self-hosted deployments leave it off.
    "MARKETING_SITE": "on",
    // session and app-token lookups cached per isolate (src/server/auth.ts)
    "AUTH_CACHE": "1",
    // workspace rows read by id cached per isolate for 10 s (src/server/repo-cache.ts)
    "REPO_CACHE": "1",
    "PUBLIC_URL": "https://grimnotes.app",
    // accounts on (docs/self-hosting.md "Sign-in"): Google sign-in, guests only read and edit; off is the default
    "SIGN_IN": "on",
    // Google sign-in (OAuth client "web" in Google Cloud project abattoir-512615; redirect ${PUBLIC_URL}/auth/google/callback).
    // The secret: wrangler secret put GOOGLE_CLIENT_SECRET
    "GOOGLE_CLIENT_ID": "110461910085-cabfna9v4khv2vgbnmejt2h94gfb4t0b.apps.googleusercontent.com",
    // the demo workspace goes back to its tour this often (the */5 cron, src/workers/cron.ts)
    "DEMO_RESET_MINUTES": "15",
    // who may open the launch metrics dashboard, /admin/stats (src/server/metrics.ts; everyone else gets a 404)
    "ADMIN_EMAILS": "longster@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grim",
      "database_id": "ebe069c1-261f-4b1c-b491-d4cb1ce21cb3",
      "migrations_dir": "migrations"
    }
  ],
  // images (content-addressed, "<workspace>/<sha256>") and nightly exports ("backups/<workspace>/<date>.zip")
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "grim-images" }],
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "HOME", "class_name": "HomeDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceDO", "HubDO", "ShellDO", "HomeDO"] },
    // HubDO fed /api/events (SSE), which is gone: its objects are deleted
    { "tag": "v2", "deleted_classes": ["HubDO"] },
    // ShellDO ran the multi-file agent shell; the note shell runs in the WorkspaceDO (docs/storage-v2.md)
    { "tag": "v3", "deleted_classes": ["ShellDO"] }
  ],
  // src/workers/cron.ts: the demo reset on the 5-minute tick that crosses a DEMO_RESET_MINUTES boundary; session
  // pruning every 6 hours; every workspace's export to R2 nightly
  "triggers": {
    "crons": ["*/5 * * * *", "0 */6 * * *", "0 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "env": {
    // `wrangler deploy --env staging` (CF-34): its own Worker, D1 and R2 bucket. Secrets (wrangler secret put …
    // --env staging): GOOGLE_CLIENT_SECRET, IMPORT_TOKEN (the storage-v2 import). Vars, D1, R2 and Durable Object
    // bindings aren't inherited, so they're repeated here.
    "staging": {
      "name": "grim-staging",
      // Workers Custom Domain; with routes set, wrangler turns the workers.dev URL off (one public origin)
      "routes": [{ "pattern": "staging.grimnotes.app", "custom_domain": true }],
      "vars": {
        "TRUSTED_PROXIES": "none",
        "MARKETING_SITE": "on",
        "AUTH_CACHE": "1",
        "REPO_CACHE": "1",
        "PUBLIC_URL": "https://staging.grimnotes.app",
        "SIGN_IN": "on",
        // the same Google OAuth client as production (secret: wrangler secret put GOOGLE_CLIENT_SECRET --env staging)
        "GOOGLE_CLIENT_ID": "110461910085-cabfna9v4khv2vgbnmejt2h94gfb4t0b.apps.googleusercontent.com",
        "DEMO_RESET_MINUTES": "15",
        "ADMIN_EMAILS": "longster@gmail.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "grim-staging",
          "database_id": "759c05d6-2f41-4eec-9501-09e1ab7562bd",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "grim-staging-images" }],
      "durable_objects": {
        "bindings": [
          { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
          { "name": "HOME", "class_name": "HomeDO" }
        ]
      }
    }
  }
}
