{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grim",
  "main": "src/workers/index.ts",
  // Must be ≤ the pinned workerd's newest supported date (workerd 1.20260811.1 → 2026-08-18)
  // and ≥ 2026-04-21 (enhanced_error_serialization keeps error names across RPC).
  "compatibility_date": "2026-08-18",
  // enable_request_signal: without it a Durable Object never sees an SSE client go away (HubDO, /api/events).
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Bun-only modules the shared code imports, swapped for their Workers versions or stand-ins (src/workers/stubs.ts).
  // Keys are import specifiers as written; values are resolved from the project root.
  "alias": {
    "./trust.ts": "./src/server/shell/trust.workers.ts",
    // until config.ts stops importing node:fs
    "node:fs": "./src/workers/stubs.ts"
  },
  // The static site is staged so URLs match the Bun server: dist/ under /dist/, and the app's HTML, CSS and the
  // Cloudflare _headers/_redirects (written by `bun run build:client`) at the root. Run the client build first.
  "build": {
    "command": "rm -rf .wrangler/assets && mkdir -p .wrangler/assets && cp -al dist .wrangler/assets/dist && cd .wrangler/assets && for f in index.html app.css editor.css _headers _redirects; do if [ -e dist/$f ]; then mv dist/$f .; fi; done && rm -f dist/*.gz"
  },
  "assets": {
    "directory": "./.wrangler/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws*", "/auth/*", "/a/*", "/mcp", "/connect", "/webhooks/*"]
  },
  // Production (`wrangler deploy`, CF-36): Worker grim at https://grimnotes.app. Secrets (wrangler secret put …):
  // CODE_STORAGE_ORG, CODE_STORAGE_PRIVATE_KEY, CODE_STORAGE_WEBHOOK_SECRET. Local `wrangler dev` overrides the
  // production-only vars (bun run dev:workers, scripts/wrangler-dev.ts; docs/06-cloudflare.md).
  // Workers Custom Domain; with routes set, wrangler turns the workers.dev URL off (one public origin)
  "routes": [{ "pattern": "grimnotes.app", "custom_domain": true }],
  "vars": {
    // Cloudflare's CF-Connecting-IP is the caller's address; no X-Forwarded-For is believed (src/server/proxy.ts).
    "TRUSTED_PROXIES": "none",
    // session and app-token lookups cached per isolate (src/server/auth.ts)
    "AUTH_CACHE": "1",
    // workspace rows read by id cached per isolate for 10 s (src/server/repo-cache.ts)
    "REPO_CACHE": "1",
    "PUBLIC_URL": "https://grimnotes.app",
    "STORAGE": "codestorage",
    // production's Code Storage repos are "app-<workspace>" (staging's "stg-", the old Bun site's unprefixed)
    "CODE_STORAGE_REPO_PREFIX": "app-",
    // name-only sign-in until production has a Google OAuth client (B3)
    "ALLOW_DEV_LOGIN": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grim",
      "database_id": "ebe069c1-261f-4b1c-b491-d4cb1ce21cb3",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "HUB", "class_name": "HubDO" },
      { "name": "SHELL", "class_name": "ShellDO" },
      { "name": "HOME", "class_name": "HomeDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceDO", "HubDO", "ShellDO", "HomeDO"] }
  ],
  // src/workers/cron.ts: read-only GitHub copies refreshed every 5 minutes; demo reset + session pruning every 6 hours
  "triggers": {
    "crons": ["*/5 * * * *", "0 */6 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "env": {
    // `wrangler deploy --env staging` (CF-34): its own Worker and D1; Code Storage repos are "stg-<workspace>" in the
    // org it shares with production. Secrets (wrangler secret put … --env staging): CODE_STORAGE_ORG,
    // CODE_STORAGE_PRIVATE_KEY, CODE_STORAGE_WEBHOOK_SECRET. Vars, D1 and Durable Object bindings aren't inherited, so they're repeated here.
    "staging": {
      "name": "grim-staging",
      // Workers Custom Domain; with routes set, wrangler turns the workers.dev URL off (one public origin)
      "routes": [{ "pattern": "staging.grimnotes.app", "custom_domain": true }],
      "vars": {
        "TRUSTED_PROXIES": "none",
        "AUTH_CACHE": "1",
        "REPO_CACHE": "1",
        "PUBLIC_URL": "https://staging.grimnotes.app",
        "STORAGE": "codestorage",
        "CODE_STORAGE_REPO_PREFIX": "stg-",
        // name-only sign-in until staging has a Google OAuth client (B3)
        "ALLOW_DEV_LOGIN": "1"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "grim-staging",
          "database_id": "759c05d6-2f41-4eec-9501-09e1ab7562bd",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
          { "name": "HUB", "class_name": "HubDO" },
          { "name": "SHELL", "class_name": "ShellDO" },
          { "name": "HOME", "class_name": "HomeDO" }
        ]
      }
    }
  }
}
