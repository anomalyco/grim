diff --git a/src/server/links.ts b/src/server/links.ts
new file mode 100644
index 0000000..4be7a10
--- /dev/null
+++ b/src/server/links.ts
@@ -0,0 +1,21 @@
+import { randomId } from "./ids";
+import type { Db } from "./db";
+
+export interface ShareLink {
+  id: string;
+  workspace: string;
+  access: "view" | "edit";
+  expiresAt: number | null;
+}
+
+// A link lasts 7 days unless the owner picks otherwise.
+const DEFAULT_TTL = 7 * 24 * 60 * 60 * 1000;
+
+export async function createLink(db: Db, workspace: string, access: "view" | "edit" = "view") {
+  const link: ShareLink = { id: randomId(12), workspace, access, expiresAt: Date.now() + DEFAULT_TTL };
+  await db.run("insert into share_links (id, workspace, access, expires_at) values (?, ?, ?, ?)", [link.id, workspace, access, link.expiresAt]);
+  return link;
+}
+
+export const isExpired = (link: ShareLink, now = Date.now()) =>
+  link.expiresAt != null && link.expiresAt < now;
