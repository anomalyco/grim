#!/usr/bin/env bun
// grimoire: run commands in a Grimoire server's shell (POST /api/shell). No dependencies besides Bun.
//   grimoire 'grep -rn TODO /workspace/notes'   run one command; exits with its exit code
//   grimoire                                     interactive shell (when stdin is a terminal)
//   echo 'ls' | grimoire                         run a script from stdin
// Settings: GRIMOIRE_URL and GRIMOIRE_TOKEN, or {"url", "token"} in ~/.config/grimoire/config.json.
// GRIMOIRE_SESSION picks the shell session (cwd, variables, /tmp); one-off commands share "default".
import { readFileSync, statSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { createInterface } from "node:readline";

const USAGE = `usage: grimoire [-t SECONDS] [-c] [command...]
  With a command (or -c 'command'): run it in the Grimoire shell and exit with its exit code.
  Without one: start an interactive shell (or run stdin as a script when it isn't a terminal).
  -t, --timeout SECONDS   time limit per command (default 30, max 110)
Environment: GRIMOIRE_URL, GRIMOIRE_TOKEN (or ~/.config/grimoire/config.json {"url", "token"}), GRIMOIRE_SESSION.
`;

interface Result {
  stdout: string;
  stderr: string;
  exitCode: number;
  cwd?: string;
}

class ClientError extends Error {}

function die(msg: string, code = 2): never {
  process.stderr.write(`grimoire: ${msg}\n`);
  process.exit(code);
}

function settings(): { url: string; token: string } {
  let file: { url?: unknown; token?: unknown } = {};
  const path = join(process.env.XDG_CONFIG_HOME || join(homedir(), ".config"), "grimoire", "config.json");
  try {
    const parsed: unknown = JSON.parse(readFileSync(path, "utf8"));
    if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) file = parsed as typeof file;
    else process.stderr.write(`grimoire: ignoring ${path}: expected a JSON object\n`);
    if (process.platform !== "win32" && statSync(path).mode & 0o077) {
      process.stderr.write(`grimoire: warning: ${path} holds a token but is readable by others; run chmod 600 ${path}\n`);
    }
  } catch (e) {
    if ((e as NodeJS.ErrnoException).code !== "ENOENT") die(`can't read ${path}: ${(e as Error).message}`);
  }
  const url = process.env.GRIMOIRE_URL || (typeof file.url === "string" ? file.url : "");
  const token = process.env.GRIMOIRE_TOKEN || (typeof file.token === "string" ? file.token : "");
  if (!url || !token) die(`set GRIMOIRE_URL and GRIMOIRE_TOKEN (an agent token from the app), or put {"url", "token"} in ${path}`);
  return { url: url.replace(/\/+$/, ""), token };
}

async function run(cfg: { url: string; token: string }, command: string, session: string, timeout?: number, signal?: AbortSignal): Promise<Result> {
  let res: Response;
  try {
    res = await fetch(`${cfg.url}/api/shell`, {
      method: "POST",
      headers: { authorization: `Bearer ${cfg.token}`, "content-type": "application/json", "x-shell-session": session },
      body: JSON.stringify({ command, session, ...(timeout ? { timeout_seconds: timeout } : {}) }),
      signal,
    });
  } catch (e) {
    if ((e as Error).name === "AbortError") throw e;
    throw new ClientError(`can't reach ${cfg.url}: ${(e as Error).message}`);
  }
  const body = (await res.json().catch(() => null)) as (Result & { error?: string }) | null;
  if (!res.ok || !body || typeof body.exitCode !== "number") throw new ClientError(`${res.status} ${body?.error ?? res.statusText}`);
  return body;
}

function print(r: Result) {
  if (r.stdout) process.stdout.write(r.stdout);
  if (r.stderr) process.stderr.write(r.stderr);
}

/** Whether more lines are needed to complete a command: an open heredoc, or a trailing unescaped backslash. */
export function incomplete(text: string): boolean {
  const lines = text.split("\n");
  const open: Array<{ delim: string; strip: boolean }> = [];
  for (const line of lines) {
    const here = open[0];
    if (here) {
      // Inside a heredoc body: only its delimiter line matters.
      if ((here.strip ? line.replace(/^\t+/, "") : line) === here.delim) open.shift();
      continue;
    }
    // `<<<` is a here-string, not a heredoc.
    for (const m of line.matchAll(/(?<!<)<<(-?)\s*(['"]?)([A-Za-z_][A-Za-z0-9_]*)\2/g)) {
      if (line[m.index! + 2] === "<") continue;
      open.push({ delim: m[3]!, strip: m[1] === "-" });
    }
  }
  if (open.length) return true;
  const trailing = /\\+$/.exec(lines[lines.length - 1]!);
  return !!trailing && trailing[0].length % 2 === 1;
}

async function repl(cfg: { url: string; token: string }, session: string, timeout?: number): Promise<number> {
  process.stderr.write(`grimoire: connected to ${cfg.url} (session ${session}; export GRIMOIRE_SESSION=${session} to come back to it). Ctrl-D to quit.\n`);
  let cwd = "/workspace";
  const prompt = () => `grimoire:${cwd === "/workspace" ? "~" : cwd.startsWith("/workspace/") ? "~" + cwd.slice(10) : cwd}$ `;
  const rl = createInterface({ input: process.stdin, output: process.stdout, terminal: true, historySize: 1000 });
  let buffer = "";
  let running: AbortController | null = null;
  let lastExit = 0;

  rl.on("SIGINT", () => {
    if (running) return running.abort();
    buffer = "";
    // Drop what was typed on the current line, like a shell does.
    rl.write(null, { ctrl: true, name: "u" });
    process.stdout.write("^C\n");
    rl.setPrompt(prompt());
    rl.prompt();
  });
  const closed = new Promise<void>((resolve) => rl.once("close", () => resolve()));

  try {
    const r = await run(cfg, "true", session);
    if (r.cwd) cwd = r.cwd;
  } catch (e) {
    process.stderr.write(`grimoire: ${(e as Error).message}\n`);
  }
  rl.setPrompt(prompt());
  rl.prompt();
  for await (const line of rl) {
    buffer = buffer ? `${buffer}\n${line}` : line;
    if (incomplete(buffer)) {
      rl.setPrompt("> ");
      rl.prompt();
      continue;
    }
    const command = buffer;
    buffer = "";
    const exit = /^\s*(?:exit|logout)(?:\s+(\d+))?\s*$/.exec(command);
    if (exit) {
      if (exit[1] !== undefined) lastExit = Number(exit[1]) & 255;
      break;
    }
    if (command.trim()) {
      running = new AbortController();
      try {
        const r = await run(cfg, command, session, timeout, running.signal);
        print(r);
        if (r.stdout && !r.stdout.endsWith("\n")) process.stdout.write("\n");
        lastExit = r.exitCode;
        if (r.cwd) cwd = r.cwd;
      } catch (e) {
        if ((e as Error).name === "AbortError") process.stderr.write("^C (stopped; the server cancels the command and drops its unsaved writes)\n");
        else process.stderr.write(`grimoire: ${(e as Error).message}\n`);
        lastExit = (e as Error).name === "AbortError" ? 130 : 255;
      }
      running = null;
    }
    rl.setPrompt(prompt());
    rl.prompt();
  }
  rl.close();
  await closed;
  process.stdout.write("\n");
  return lastExit;
}

async function main() {
  const args = process.argv.slice(2);
  let timeout: number | undefined;
  while (args.length && args[0]!.startsWith("-")) {
    const a = args.shift()!;
    if (a === "--") break;
    if (a === "-h" || a === "--help") {
      process.stdout.write(USAGE);
      return 0;
    }
    if (a === "-t" || a === "--timeout" || a.startsWith("--timeout=")) {
      const v = a.startsWith("--timeout=") ? a.slice(10) : args.shift();
      timeout = Number(v);
      if (!Number.isFinite(timeout) || timeout < 1 || timeout > 110) die(`invalid timeout: ${v} (1-110 seconds)`);
      continue;
    }
    if (a === "-c") {
      if (!args.length) die("-c needs a command");
      break;
    }
    die(`unknown option ${a}\n${USAGE}`);
  }
  const cfg = settings();
  const envSession = process.env.GRIMOIRE_SESSION?.trim();
  if (envSession && !/^[A-Za-z0-9._:-]{1,128}$/.test(envSession)) die("GRIMOIRE_SESSION must be 1-128 characters of A-Z a-z 0-9 . _ : -");

  if (!args.length && process.stdin.isTTY) return repl(cfg, envSession || `tty-${crypto.randomUUID().slice(0, 8)}`, timeout);
  const command = args.length ? args.join(" ") : await Bun.stdin.text();
  if (!command.trim()) return 0;
  try {
    const r = await run(cfg, command, envSession || "default", timeout);
    print(r);
    return r.exitCode;
  } catch (e) {
    process.stderr.write(`grimoire: ${(e as Error).message}\n`);
    return 255;
  }
}

if (import.meta.main) process.exitCode = await main();
